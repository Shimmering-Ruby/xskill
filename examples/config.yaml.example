# xskill config template — copy to ~/.xskill/config.yaml and edit.
#
# First run after install:
#   mkdir -p ~/.xskill
#   cp examples/config.yaml.example ~/.xskill/config.yaml
#   # then edit llm.api_key / embedding.api_key
#
# xskill does NOT read environment variables or any key file. Missing
# required fields raise FileNotFoundError / KeyError loudly — no silent
# fallback.

# ===== Skill repository =====
skill_dir: ~/.xskill/skill            # the single global skill repo (any absolute path works)

# ===== LLM (used for generation / scoring / chat) =====
# Any OpenAI-compatible chat-completions endpoint. Examples:
#   OpenAI      https://api.openai.com/v1
#   DeepSeek    https://api.deepseek.com
#   OpenRouter  https://openrouter.ai/api/v1
#   (local)     http://127.0.0.1:11434/v1   (Ollama, etc.)
llm:
  base_url: https://api.openai.com/v1
  model:    gpt-4o-mini
  api_key:  PUT_YOUR_LLM_API_KEY_HERE
  max_tokens: 10000      # optional. A "thinking" model needs enough budget for
                         # reasoning_tokens + content; too small makes meta
                         # extraction return empty / truncated → rule fallback.
  # temperature: 0.0     # optional; default 0 (deterministic)

# ===== Embedding (used for vector retrieval) =====
# Any OpenAI-compatible embeddings endpoint. `dim: 0` auto-probes the
# dimension on first call.
embedding:
  base_url: https://api.openai.com/v1
  model:    text-embedding-3-small
  api_key:  PUT_YOUR_EMBEDDING_API_KEY_HERE
  dim:      0                      # 0 = auto-probe
  # api: openai | multimodal       # optional; default openai. Set "multimodal"
                                   # for vision-style embedding endpoints.

# ===== L2 sandbox eval (runs SWE-bench A/B/C in docker; used by eval scripts) =====
sandbox:
  enabled:           true
  max_instances:     5              # instances per eval run
  n_trials:          10             # repeats per instance (the N in pass@1)
  timeout_per_trial: 300            # wall-clock timeout per trial (seconds)
  trigger_threshold: 3              # a skill needs ≥ N linked SWE instances to trigger

# ===== Skill candidate gating (when a .candidates.yml entry is promoted to SKILL.md) =====
candidates:
  threshold:        3               # promote once supporting_trajs ≥ N
  stale_days:       60              # after N days still short → demote to references/
  min_source_trajs: 2               # a new skill needs ≥ N source_trajs

# ===== Skill edit agent (limits for the promotion sub-agent) =====
skill_edit_agent:
  tool_call_limit:     20           # max tool calls per promote
  timeout_seconds:     600          # wall-clock timeout (keeps partial writes, no raise)
  read_file_max_bytes: 15000        # read_file truncation per call

# ===== Canary (gradual rollout: a staging branch probabilistically replaces
#       main; once both sides have ≥ min_samples UX scores, compare and
#       merge the winner / discard the loser) =====
canary:
  enabled:       true
  probability:   0.2                # on a retrieval hit, route to staging with prob p
  min_samples:   5                  # need ≥ N UX scores on each side to decide
  max_days_hold: 14                 # max staging lifetime; discarded on timeout
  rotate_interval: 300              # standalone-mode canary time-window rotation (seconds)

# ===== Team C/S mode (only read by `xskill serve --server`) =====
# The client does NOT read config.yaml — its connection info lives in
# ~/.xskill/team_client.json, written on first `xskill connect <host:port>
# --token <token>` handshake.
team:
  server:
    traj_root: ~/.xskill/team_trajectories   # root where client-uploaded trajectories land
    skill_slots: 100                         # max skills a client holds locally
    ranked_slots: 80                         # of which N are the ux_score sliding-window
                                             # top picks; the remaining 20 = recommended bucket

# ===== Watcher (the directory poller built into `serve`) =====
watcher:
  poll_interval: 30                 # seconds; each round scans every watch_dir,
                                    # new files flow meta → embed → process → ux_score
  max_concurrent: 30                # ThreadPoolExecutor size. Meta extraction is
                                    # LLM-I/O-bound so high concurrency really helps
                                    # cold-start bulk indexing. Bounded by your LLM
                                    # provider's RPM limit.
  cold_start_threshold: 3           # if a watch_dir still has ≥ N un-indexed trajectories,
                                    # defer process_traj to the next round so the agent
                                    # sees a full index snapshot. 1 = fully sequential;
                                    # 999 ≈ gate disabled.
