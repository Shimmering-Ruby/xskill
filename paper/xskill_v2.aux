\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Cross-Agent Trajectory Collection}{4}{subsection.3.1}\protected@file@percent }
\newlabel{sec:collection}{{3.1}{4}{Cross-Agent Trajectory Collection}{subsection.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Cross-agent trajectory collection.} Each coding agent writes trajectories in its native format. The xskill client runs per-agent adapters that normalize events into a unified schema. Four of five agents use appendable JSONL, enabling efficient \texttt  {inotify}/\texttt  {tail} collection; OpenCode's SQLite database requires polling.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:collection}{{2}{5}{\textbf {Cross-agent trajectory collection.} Each coding agent writes trajectories in its native format. The xskill client runs per-agent adapters that normalize events into a unified schema. Four of five agents use appendable JSONL, enabling efficient \texttt {inotify}/\texttt {tail} collection; OpenCode's SQLite database requires polling}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Three-agent pipeline.} \emph  {TaskAgent} decomposes trajectory deltas into AtomTask segments. \emph  {TaskClusterAgent} routes each atom to an existing or new skill, appending weighted evidence. \emph  {SkillEditAgent} fires when cumulative evidence exceeds a threshold (default: weight $\geq 10$), producing or updating SKILL.md via git commit.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:pipeline}{{3}{5}{\textbf {Three-agent pipeline.} \emph {TaskAgent} decomposes trajectory deltas into AtomTask segments. \emph {TaskClusterAgent} routes each atom to an existing or new skill, appending weighted evidence. \emph {SkillEditAgent} fires when cumulative evidence exceeds a threshold (default: weight $\geq 10$), producing or updating SKILL.md via git commit}{figure.3}{}}
