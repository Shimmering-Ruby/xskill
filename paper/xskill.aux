\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {xskill system overview.} Developers use their preferred coding agents (Claude Code, Codex, OpenCode, etc.). The xskill client daemon watches trajectory directories and uploads sanitized deltas to the central server. The server's three-agent pipeline decomposes trajectories into atomic tasks, clusters them into skill candidates, and produces versioned SKILL.md artifacts via git commits. Evolved skills are synced back to each developer's agent runtime.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:overview}{{1}{2}{\textbf {xskill system overview.} Developers use their preferred coding agents (Claude Code, Codex, OpenCode, etc.). The xskill client daemon watches trajectory directories and uploads sanitized deltas to the central server. The server's three-agent pipeline decomposes trajectories into atomic tasks, clusters them into skill candidates, and produces versioned SKILL.md artifacts via git commits. Evolved skills are synced back to each developer's agent runtime}{figure.1}{}}
