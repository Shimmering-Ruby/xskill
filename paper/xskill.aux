\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Canary evaluation protocol.} When the SkillEditAgent produces an updated skill, it commits to a staging branch. The xskill server routes a subset of users ($u_4, u_5$) to the staging version while the majority ($u_1, u_2, u_3$) continue on main. UX scores from AtomTasks using each branch are aggregated; the staging branch is promoted to main only if its mean score exceeds main's.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:canary}{{5}{7}{\textbf {Canary evaluation protocol.} When the SkillEditAgent produces an updated skill, it commits to a staging branch. The xskill server routes a subset of users ($u_4, u_5$) to the staging version while the majority ($u_1, u_2, u_3$) continue on main. UX scores from AtomTasks using each branch are aggregated; the staging branch is promoted to main only if its mean score exceeds main's}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Skill output paths for 5 agent ecosystems.} The SKILL.md format with YAML frontmatter (\texttt  {name} + \texttt  {description}) is the cross-agent interoperability unit. Two filesystem paths---\texttt  {\~{}/.claude/skills/} and \texttt  {\~{}/.agents/skills/}---cover 4 of 5 ecosystems; only Hermes requires a dedicated path.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:distribution}{{2}{7}{\textbf {Skill output paths for 5 agent ecosystems.} The SKILL.md format with YAML frontmatter (\texttt {name} + \texttt {description}) is the cross-agent interoperability unit. Two filesystem paths---\texttt {\~{}/.claude/skills/} and \texttt {\~{}/.agents/skills/}---cover 4 of 5 ecosystems; only Hermes requires a dedicated path}{table.2}{}}
