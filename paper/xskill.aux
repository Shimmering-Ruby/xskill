\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Skill injection strategies.} xskill does not inject skills itself---it publishes to disk, and the host runtime's loader handles injection. This decoupling is deliberate: it preserves each runtime's native caching, trimming, and compaction behavior.}}{9}{table.4}\protected@file@percent }
\newlabel{tab:injection}{{4}{9}{\textbf {Skill injection strategies.} xskill does not inject skills itself---it publishes to disk, and the host runtime's loader handles injection. This decoupling is deliberate: it preserves each runtime's native caching, trimming, and compaction behavior}{table.4}{}}
