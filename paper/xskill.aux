\newlabel{sec:collection}{{3.1}{4}{Cross-Agent Trajectory Collection}{subsection.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Three-agent pipeline.} \emph  {TaskAgent} decomposes trajectory deltas into AtomTask segments. \emph  {TaskClusterAgent} routes each atom to an existing or new skill, appending weighted evidence. \emph  {SkillEditAgent} fires when cumulative evidence exceeds a threshold (default: weight$\geq $10), producing or updating SKILL.md via git commit.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:pipeline}{{4}{5}{\textbf {Three-agent pipeline.} \emph {TaskAgent} decomposes trajectory deltas into AtomTask segments. \emph {TaskClusterAgent} routes each atom to an existing or new skill, appending weighted evidence. \emph {SkillEditAgent} fires when cumulative evidence exceeds a threshold (default: weight$\geq $10), producing or updating SKILL.md via git commit}{figure.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Sanitization.}{5}{section*.1}\protected@file@percent }
